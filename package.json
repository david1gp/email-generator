{
  "name": "@adaptive-ds/email-generator",
  "version": "0.13.1",
  "scripts": {
    "dev": "bun run dev:email",
    "dev:email": "email dev --dir=./src/templates",
    "dev:bun": "bun ./src/server/server.ts --hot",
    "dev:worker": "wrangler dev",
    "deploy": "bun run deploy:david && bun run deploy:leg-tj && bun run deploy:leo",
    "deploy:david": "cp -f .env.david .env && bun run wrangler deploy --var VERSION:`bun run getVersion` --config wrangler.david.toml",
    "deploy:leg-tj": "cp -f .env.leg-tj .env && bun run wrangler deploy --var VERSION:`bun run getVersion` --config wrangler.leg-tj.toml",
    "deploy:leo": "cp -f .env.leo .env && bun run wrangler deploy --var VERSION:`bun run getVersion` --config wrangler.leo.toml",
    "getVersion": "bun run src/ops/printPackageVersion.ts",
    "generateExports": "bun run src/generateExports.ts",
    "generateBarrel": "bun run src/generateBarrelImports.ts",
    "build": "rm -rf ./dist && bun tsc -p ./tsconfig.lib.json",
    "tail": "wrangler tail email-generator-worker",
    "test": "bun test --preload ./test/setup.ts",
    "test:w": "bun test --preload ./test/setup.ts --watch",
    "uploadImages": "rclone sync -v --progress --track-renames ~/Coding/adaptive/email-generator/public-images/ email-generator-images:email-generator-images/",
    "generateJpg": "bash ./ops/generateJpg.sh",
    "release": "bash ./ops/release.sh",
    "update": "bun x npm-check-updates -u && bun i",
    "update:commit": "bun x npm-check-updates -u && bun i && git add package.json && bun run tsc && git commit -m \"chore(deps): update dependencies\" && git push",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules"
  },
  "peerDependencies": {
    "@adaptive-ds/result": ">=0.4.0",
    "@adaptive-ds/utils": ">=0.7.0",
    "dayjs": "^1.11.18",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260505.1",
    "@hono/standard-validator": "^0.2.2",
    "@hono/swagger-ui": "^0.6.1",
    "@react-email/components": "^1.0.12",
    "@react-email/preview-server": "^5.2.10",
    "@react-email/render": "^2.0.8",
    "@react-email/ui": "6.0.8",
    "@types/bun": "latest",
    "@valibot/to-json-schema": "^1.6.0",
    "hono": "^4.12.16",
    "hono-openapi": "^1.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-email": "^6.0.8",
    "typescript": "^6.0.3",
    "wrangler": "^4.87.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "type": "module",
  "private": false,
  "license": "MIT",
  "homepage": "https://github.com/david1gp/email-generator",
  "description": "A lightweight, self-hostable service for rendering HTML emails with React Email",
  "keywords": [
    "email",
    "templates",
    "react-email",
    "html-email",
    "serverless",
    "cloudflare-workers",
    "bun",
    "typescript"
  ],
  "repository": {
    "url": "git+https://github.com/david1gp/email-generator.git"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.js": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ]
}
